# Use the official Microsoft Windows Server Core image
FROM mcr.microsoft.com/windows/servercore/iis:ltsc2022

# Set PowerShell as the default shell for configuration
SHELL ["powershell", "-Command", "$ErrorActionPreference = 'Stop'; $ProgressPreference = 'SilentlyContinue';"]

# Download and install Python natively inside the Windows container
RUN Invoke-WebRequest -Uri https://python.org -OutFile python-installer.exe; \
    Start-Process python-installer.exe -ArgumentList '/quiet InstallAllUsers=1 PrependPath=1' -Wait; \
    Remove-Item python-installer.exe

# Verify installation and upgrade pip
RUN python --version; \
    python -m pip install --upgrade pip

# Set the working directory
WORKDIR C:/inetpub/wwwroot

# Clear the IIS root directory to prepare for the application files
RUN Remove-Item -Recurse -Force C:\inetpub\wwwroot\*

# Copy the application code
COPY . .

# Define the command to run your Python script
CMD ["python", "drtbrt.py"]

# Document the intended port for the application
EXPOSE 80
